#!/usr/bin/env bash
# Prints GATE_OWNER_APPROVED=1 when a code owner other than the author has an
# approving review. Owners come from the base branch, so a PR cannot add itself.
set -euo pipefail

: "${REPO:?}" "${PR_NUMBER:?}" "${PR_AUTHOR:?}" "${BASE_REF:?}"

owners="$(git show "origin/$BASE_REF:.github/CODEOWNERS" 2>/dev/null |
  grep -v '^#' | grep -oE '@[A-Za-z0-9-]+' | tr -d '@' | sort -u || true)"

approvers="$(gh api --paginate "repos/$REPO/pulls/$PR_NUMBER/reviews" --jq '.[] | [.user.login, .state] | @tsv' |
  awk -F'\t' '$2 != "COMMENTED" { latest[$1] = $2 } END { for (u in latest) if (latest[u] == "APPROVED") print u }')"

for user in $approvers; do
  if [ "$user" != "$PR_AUTHOR" ] && grep -qxF "$user" <<<"$owners"; then
    echo "GATE_OWNER_APPROVED=1"
    exit 0
  fi
done
