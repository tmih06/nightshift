#!/usr/bin/env bash
# Compares the render benchmarks between the base branch and HEAD.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
PATH="$PWD/.tools/bin:$PATH"
base="${GATE_BASE:-origin/main}"
# The base branch may still use the old layout, so each tree runs the packages it has.
candidates=(./internal/dashboard ./internal/repoview ./internal/session
  ./internal/tui/dashboard ./internal/tui/repoview ./internal/services/session)
existing() {
  local p
  for p in "${candidates[@]}"; do
    if [ -d "$p" ]; then printf '%s\n' "$p"; fi
  done
}
flags=(-run '^$' -bench . -benchmem -count=6 -benchtime=20x)

work="$(mktemp -d)"
cleanup() {
  git worktree remove --force "$work/base" 2>/dev/null || true
  rm -rf "$work"
}
trap cleanup EXIT

git worktree add --quiet --detach "$work/base" "$(git merge-base "$base" HEAD)"
(cd "$work/base" && mapfile -t pkgs < <(existing) && go test "${flags[@]}" "${pkgs[@]}") >"$work/old.txt"
mapfile -t pkgs < <(existing)
go test "${flags[@]}" "${pkgs[@]}" >"$work/new.txt"
# benchstat pairs results by package, so a package that moved pairs with itself.
sed -i -E 's#^(pkg: .*/internal)/(tui|services)/#\1/#' "$work/old.txt" "$work/new.txt"
benchstat "$work/old.txt" "$work/new.txt"
